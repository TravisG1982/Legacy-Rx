# Copy to .env.local for local development. Never commit real values.
# The VITE_ values are public and included in the browser bundle.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase sb_secret_... key; the variable name is retained for compatibility.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=https://legacyrx.net

# Server-only session signing for the qualification flow
SESSION_SECRET=

# Current FuseHealth checkout and webhook (server-only).
# FUZERX_API_KEY is the FuseHealth Brand API key; the name is historical. Do not remove it.
FUZERX_API_KEY=
FUSE_WEBHOOK_SECRET=

# GA4 and Meta are disabled in code (src/lib/analytics.ts, /api/public/meta-capi). No GA4 or Meta
# variable is read; do not add one. A future, separately approved setup will define its own.

# LegacyRX Stripe TEST-mode payments (Preview first; optional QA on main deployment after merge).
# Works only with an sk_test_ key. Live keys are rejected.
STRIPE_TEST_PAYMENTS_ENABLED=
STRIPE_TEST_SECRET_KEY=
STRIPE_TEST_WEBHOOK_SECRET=
STRIPE_TEST_ALLOWED_EMAIL=
# Exact origin being tested (local, Preview, or main deployment); each hosted environment needs its own webhook destination/secret.
STRIPE_TEST_RETURN_ORIGIN=
# Optional, provisional until agreed with Beluga: automatic (default) or manual (authorize only)
STRIPE_TEST_CAPTURE_METHOD=
