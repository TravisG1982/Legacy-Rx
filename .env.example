# Current FuseHealth checkout and webhook (server-only)
FUZERX_API_KEY=
FUSE_WEBHOOK_SECRET=

# Optional legacy integrations and features
FUZERX_WEBHOOK_KEY=
FUZERX_QUESTIONNAIRE_ID=
