SUPABASE_PUBLISHABLE_KEY=
# Server-only Supabase sb_secret_... key; the variable name is retained for compatibility.
SUPABASE_SERVICE_ROLE_KEY=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SITE_URL=https://legacyrx.net

# Server-only authentication and admin access
SESSION_SECRET=
